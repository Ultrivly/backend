# Copy to .env for local development. Matches compose.yaml.
DATABASE_URL=postgres://ultrivly:ultrivly@localhost:55432/ultrivly
RUST_LOG=info
# File storage: memory:// (lost on exit), file:///absolute/dir, or s3://bucket[/prefix]
# with the standard AWS_* variables (set AWS_ENDPOINT for MinIO or another S3-compatible server).
ULTRIVLY_STORAGE_URL=memory://
# Authentication. Generate the key with: cargo run -- secret-key
ULTRIVLY_SECRET_KEY=
ULTRIVLY_PUBLIC_URL=http://localhost:3000
ULTRIVLY_DEPLOYMENT=self_hosted
# Self-hosted only: internal hosts outbound requests may reach, e.g. keycloak.internal
ULTRIVLY_NET_ALLOW=
# HTTP server
ULTRIVLY_BIND=127.0.0.1:8080
# Reverse proxies in front of Ultrivly whose X-Forwarded-For is trusted (0 = none).
ULTRIVLY_TRUSTED_PROXY_HOPS=0
# Email: smtps://user:pass@host:465, smtp://user:pass@host:587?tls=required, or log:// (development only)
ULTRIVLY_MAIL_URL=log://
ULTRIVLY_MAIL_FROM=Ultrivly <no-reply@localhost>
# Optional Google sign-in
ULTRIVLY_GOOGLE_CLIENT_ID=
ULTRIVLY_GOOGLE_CLIENT_SECRET=
